{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Next.js + React: bundler resolution, JSX preserved for the Next compiler,
       DOM libs, and no emit (Next/SWC owns the build). These override the base
       NodeNext/Node settings, which are tuned for the Lambda/library packages. */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
