{
  "name": "@aya/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aya web reader (Next.js): the /s/{code} shared-page viewer with hover-to-translate. Depends only on @aya/shared and the HTTP API.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo node_modules/.cache"
  },
  "dependencies": {
    "@aya/shared": "*",
    "next": "^15.5.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
