{
  "name": "@aya/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Aya React Native app — camera capture, local-first reader, tap-to-translate. Depends only on @aya/shared and the HTTP API.",
  "main": "src/index.tsx",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "clean": "rm -rf dist dist-test .turbo"
  },
  "dependencies": {
    "@aya/shared": "*",
    "react": "^19.2.0",
    "react-native": "0.81.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  }
}
