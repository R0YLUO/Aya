{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Pure-logic modules (api client, store, scan/share orchestration, error
       mapping, reducers) are framework-free and run under node:test. They use
       Node module resolution. React/React-Native modules (hooks, .tsx screens)
       are excluded here — they are covered by `typecheck` (tsconfig.json). */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist-test",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "files": [
    "src/api/client.ts",
    "src/store/LocalPageStore.ts",
    "src/store/asyncStorageBackend.ts",
    "src/store/types.ts",
    "src/scan/runScan.ts",
    "src/scan/scanState.ts",
    "src/errors/messages.ts",
    "src/camera/types.ts",
    "src/reader/tokens.ts",
    "src/test-support/fixtures.ts",
    "src/test-support/index.ts",
    "src/api/client.test.ts",
    "src/store/LocalPageStore.test.ts",
    "src/scan/runScan.test.ts",
    "src/camera/captureReducer.test.ts",
    "src/reader/tokens.test.ts",
    "src/errors/messages.test.ts"
  ]
}
